<#
.SYNOPSIS
    Builds tree-sitter grammar DLLs using MSVC for Emacs on Windows.

.DESCRIPTION
    Clones a tree-sitter grammar repo, compiles parser.c (and scanner.c/scanner.cc
    if present) into a shared DLL using cl.exe (MSVC), and installs it to the
    Emacs tree-sitter grammar directory.

.PARAMETER Languages
    One or more language names to install (e.g. "python", "c", "rust").
    Use "all-common" to install a predefined set of popular grammars.

.PARAMETER GrammarDir
    Directory where compiled .dll files are placed.
    Defaults to "$env:APPDATA\.emacs.d\tree-sitter".

.PARAMETER TempDir
    Temporary directory for cloning repos. Defaults to "$env:TEMP\tree-sitter-build".

.PARAMETER Clean
    Remove the temp directory after building.

.EXAMPLE
    .\Install-TreeSitterGrammar.ps1 -Languages python, rust, c, cpp
.EXAMPLE
    .\Install-TreeSitterGrammar.ps1 -Languages all-common
.EXAMPLE
    .\Install-TreeSitterGrammar.ps1 -Languages python -GrammarDir "C:\emacs-grammars"
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string[]]$Languages,

    [string]$GrammarDir = "$env:APPDATA\.emacs.d\tree-sitter",

    [string]$TempDir = "$env:TEMP\tree-sitter-build",

    [switch]$Clean
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

# ── Well-known grammar repos ────────────────────────────────────────────────
# Maps language name -> (repo URL, optional subdirectory path)
$GrammarRepos = @{
    "bash"        = "https://github.com/tree-sitter/tree-sitter-bash"
    "c"           = "https://github.com/tree-sitter/tree-sitter-c"
    "cmake"       = "https://github.com/uyha/tree-sitter-cmake"
    "cpp"         = "https://github.com/tree-sitter/tree-sitter-cpp"
    "c-sharp"     = "https://github.com/tree-sitter/tree-sitter-c-sharp"
    "css"         = "https://github.com/tree-sitter/tree-sitter-css"
    "dockerfile"  = "https://github.com/camdencheek/tree-sitter-dockerfile"
    "elixir"      = "https://github.com/elixir-lang/tree-sitter-elixir"
    "go"          = "https://github.com/tree-sitter/tree-sitter-go"
    "gomod"       = "https://github.com/camdencheek/tree-sitter-go-mod"
    "haskell"     = "https://github.com/tree-sitter/tree-sitter-haskell"
    "html"        = "https://github.com/tree-sitter/tree-sitter-html"
    "java"        = "https://github.com/tree-sitter/tree-sitter-java"
    "javascript"  = "https://github.com/tree-sitter/tree-sitter-javascript"
    "json"        = "https://github.com/tree-sitter/tree-sitter-json"
    "lua"         = "https://github.com/tree-sitter-grammars/tree-sitter-lua"
    "make"        = "https://github.com/tree-sitter-grammars/tree-sitter-make"
    "markdown"    = "https://github.com/tree-sitter-grammars/tree-sitter-markdown"
    "nix"         = "https://github.com/nix-community/tree-sitter-nix"
    "python"      = "https://github.com/tree-sitter/tree-sitter-python"
    "ruby"        = "https://github.com/tree-sitter/tree-sitter-ruby"
    "rust"        = "https://github.com/tree-sitter/tree-sitter-rust"
    "toml"        = "https://github.com/tree-sitter-grammars/tree-sitter-toml"
    "tsx"         = "https://github.com/tree-sitter/tree-sitter-typescript"
    "typescript"  = "https://github.com/tree-sitter/tree-sitter-typescript"
    "yaml"        = "https://github.com/tree-sitter-grammars/tree-sitter-yaml"
    "zig"         = "https://github.com/tree-sitter-grammars/tree-sitter-zig"
}

# Languages with subdirectory src paths (monorepos)
$SubDirs = @{
    "tsx"        = "tsx"
    "typescript" = "typescript"
    "markdown"   = "tree-sitter-markdown"  # has tree-sitter-markdown/ subdir
}

$CommonLanguages = @(
    "bash", "c", "cmake", "cpp", "css", "dockerfile", "go", "html",
    "java", "javascript", "json", "lua", "make", "markdown", "nix",
    "python", "ruby", "rust", "toml", "tsx", "typescript", "yaml", "zig"
)

# ── Resolve "all-common" ────────────────────────────────────────────────────
if ($Languages.Count -eq 1 -and $Languages[0] -eq "all-common") {
    $Languages = $CommonLanguages
}

# ── Verify MSVC is available ────────────────────────────────────────────────
function Find-VsDevShell {
    # Check if cl.exe is already on PATH
    if (Get-Command cl.exe -ErrorAction SilentlyContinue) {
        Write-Host "[OK] cl.exe found on PATH" -ForegroundColor Green
        return $true
    }

    # Try to find and import VS Developer Shell
    $vswhere = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
    if (-not (Test-Path $vswhere)) {
        return $false
    }

    $vsPath = & $vswhere -latest -property installationPath 2>$null
    if (-not $vsPath) { return $false }

    $devShell = Join-Path $vsPath "Common7\Tools\Microsoft.VisualStudio.DevShell.dll"
    if (Test-Path $devShell) {
        Import-Module $devShell
        Enter-VsDevShell -VsInstallPath $vsPath -SkipAutomaticLocation -DevCmdArguments "-arch=x64 -no_logo" | Out-Null
        Write-Host "[OK] Loaded MSVC x64 environment from $vsPath" -ForegroundColor Green
        return $true
    }

    # Fallback: vcvarsall.bat
    $vcvars = Join-Path $vsPath "VC\Auxiliary\Build\vcvarsall.bat"
    if (Test-Path $vcvars) {
        cmd /c "`"$vcvars`" x64 >nul 2>&1 && set" | ForEach-Object {
            if ($_ -match "^(.+?)=(.*)$") {
                [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process")
            }
        }
        Write-Host "[OK] Loaded MSVC x64 environment via vcvarsall.bat" -ForegroundColor Green
        return $true
    }

    return $false
}

if (-not (Find-VsDevShell)) {
    Write-Error @"
Could not find MSVC (cl.exe). Please either:
  1. Run this script from a "Developer PowerShell for VS" prompt, or
  2. Install Visual Studio Build Tools with the "Desktop development with C++" workload.
"@
    exit 1
}

# Verify git
if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Error "git is not on PATH. Please install Git for Windows."
    exit 1
}

# ── Setup directories ───────────────────────────────────────────────────────
New-Item -ItemType Directory -Force -Path $GrammarDir | Out-Null
New-Item -ItemType Directory -Force -Path $TempDir    | Out-Null

# ── Build function ──────────────────────────────────────────────────────────
function Build-Grammar {
    param(
        [string]$Lang,
        [string]$RepoUrl,
        [string]$SubDir
    )

    $dllName = "libtree-sitter-$Lang.dll"
    Write-Host "`n── Building $Lang ──" -ForegroundColor Cyan

    # Clone or pull
    $repoDir = Join-Path $TempDir (Split-Path $RepoUrl -Leaf)
    if (Test-Path $repoDir) {
        Write-Host "  Updating existing clone..."
        Push-Location $repoDir
        git pull --quiet 2>$null
        Pop-Location
    } else {
        Write-Host "  Cloning $RepoUrl..."
        git clone --depth 1 --quiet $RepoUrl $repoDir
    }

    # Find the src directory
    $srcDir = if ($SubDir) {
        Join-Path $repoDir $SubDir "src"
    } else {
        Join-Path $repoDir "src"
    }

    if (-not (Test-Path (Join-Path $srcDir "parser.c"))) {
        Write-Warning "  parser.c not found in $srcDir — skipping $Lang"
        return $false
    }

    Push-Location $srcDir

    # Collect source files
    $sources = @("parser.c")
    if (Test-Path "scanner.c")  { $sources += "scanner.c" }
    if (Test-Path "scanner.cc") { $sources += "scanner.cc" }

    $hasCC = $sources | Where-Object { $_ -match '\.cc$' }

    # Build with cl.exe
    #   /O2      — optimize
    #   /LD      — create DLL
    #   /I.      — include current dir (for tree_sitter/parser.h)
    #   /utf-8   — source charset
    #   /nologo  — quiet
    $outDll = Join-Path $srcDir $dllName
    $clArgs = @("/O2", "/LD", "/I.", "/utf-8", "/nologo") + $sources + @("/Fe:$outDll")

    # If there's a C++ scanner, use /TP for that file or just let cl auto-detect by extension
    Write-Host "  Compiling: cl.exe $($sources -join ', ')"
    $output = & cl.exe @clArgs 2>&1
    $exitCode = $LASTEXITCODE

    Pop-Location

    if ($exitCode -ne 0) {
        Write-Warning "  Compilation failed for $Lang"
        Write-Host ($output | Out-String) -ForegroundColor Red
        return $false
    }

    # Copy DLL to grammar directory
    $dest = Join-Path $GrammarDir $dllName
    Copy-Item $outDll -Destination $dest -Force
    Write-Host "  Installed: $dest" -ForegroundColor Green

    # Clean up intermediate files (.obj, .lib, .exp)
    Get-ChildItem $srcDir -Include "*.obj", "*.lib", "*.exp" -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue

    return $true
}

# ── Main loop ───────────────────────────────────────────────────────────────
$success = 0
$failed  = @()

foreach ($lang in $Languages) {
    $lang = $lang.Trim().ToLower()

    if (-not $GrammarRepos.ContainsKey($lang)) {
        Write-Warning "Unknown language '$lang' — skipping. Add its repo URL to the script or use a full git URL."
        $failed += $lang
        continue
    }

    $repo   = $GrammarRepos[$lang]
    $subdir = if ($SubDirs.ContainsKey($lang)) { $SubDirs[$lang] } else { $null }

    if (Build-Grammar -Lang $lang -RepoUrl $repo -SubDir $subdir) {
        $success++
    } else {
        $failed += $lang
    }
}

# ── Summary ─────────────────────────────────────────────────────────────────
Write-Host "`n═══════════════════════════════════════" -ForegroundColor Cyan
Write-Host "  Built: $success / $($Languages.Count)" -ForegroundColor $(if ($failed.Count -eq 0) { "Green" } else { "Yellow" })
if ($failed.Count -gt 0) {
    Write-Host "  Failed: $($failed -join ', ')" -ForegroundColor Red
}
Write-Host "  Grammar dir: $GrammarDir" -ForegroundColor Cyan
Write-Host "═══════════════════════════════════════`n" -ForegroundColor Cyan

if ($Clean) {
    Write-Host "Cleaning up $TempDir..."
    Remove-Item -Recurse -Force $TempDir -ErrorAction SilentlyContinue
}

# ── Emit Emacs config hint ──────────────────────────────────────────────────
Write-Host @"
Add this to your Emacs init.el:

  (setq treesit-extra-load-path '("$($GrammarDir -replace '\\', '/')"))

"@ -ForegroundColor DarkYellow
