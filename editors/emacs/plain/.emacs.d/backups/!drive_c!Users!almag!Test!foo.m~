clear; clf;
f=@(t,y) 1-t+y;
fp=@(t,y) -t+y;
fpp=@(t,y) -t+y;
fppp=@(t,y) -t+y;
exa=@(t) (sin(74.5*t) .* exp(3*t)) ./ (1 + t .^ 2);

t = linspace(0,1,50); % 0 to 1 with 50 points
plot(t, exa(t)); grid on

return

t0=0; T=4; h=0.01/2;

for k=1:5
    h=h*2;
    y=[];
    y(1)=3; t(1)=t0;
    for i=1:round(T/h)
        y(i+1)=y(i)+h*f(t(i),y(i)) + 0.5*h^2*fp(t(i),y(i)) + (1/6)*h^3*fpp(t(i),y(i)) + (1/24)*h^4*fppp(t(i),y(i));
        t(i+1)=t(i)+h;
    end
    H(k)=h;
    sol(k)=y(end);
end

plot(H, sol,'ro-'); grid on; hold on
plot(H, abs(sol-exa(T)),'bo-');
xlabel('h')
title('Sungbae Jeong')

err=abs(sol-exa(T))
for k=1:length(err)-1
    log(err(k+1)/err(k))/log(2)
end
