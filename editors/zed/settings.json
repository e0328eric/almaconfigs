// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "wsl_connections": [
    {
      "distro_name": "archlinux",
      "user": null,
      "projects": [
        {
          "paths": ["/home"],
        },
      ],
    },
  ],
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_mode": "plan",
    },
  },
  "disable_ai": true,
  "icon_theme": "Zed (Default)",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "ui_font_size": 14,
  "buffer_font_size": 13.0,
  "buffer_font_family": "DepartureMono Nerd Font Mono",
  "wrap_guides": [80],
  //"disable_ai": true,
  "terminal": {
    "dock": "bottom",
    "font_size": 12.0,
    "font_family": "FiraCode Nerd Font Mono",
    "shell": {
      "with_arguments": {
        "program": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
          "-NoExit",
          "-Command",
          "&{Import-Module \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\Common7\\Tools\\Microsoft.VisualStudio.DevShell.dll\"; Enter-VsDevShell f6fbfad7 -SkipAutomaticLocation -DevCmdArguments \"-arch=x64 -host_arch=x64\"}; nu.exe",
        ],
      },
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Night Owl Dark",
  },
  "languages": {
    "vesti": {
      "allow_rewrap": "anywhere",
      "preferred_line_length": 80,
      "soft_wrap": "preferred_line_length",
    },
  },
}
