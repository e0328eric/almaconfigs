/*
 * install_tree_sitter_grammar.c
 *
 * Builds tree-sitter grammar DLLs using MSVC for Emacs on Windows.
 * C port of Install-TreeSitterGrammar.ps1.
 *
 * Usage:
 *   install_tree_sitter_grammar.exe [OPTIONS] LANG [LANG ...]
 *   install_tree_sitter_grammar.exe --languages python rust c cpp
 *   install_tree_sitter_grammar.exe --languages all-common
 *   install_tree_sitter_grammar.exe --languages python --grammar-dir C:\emacs-grammars
 *   install_tree_sitter_grammar.exe --clean --languages all-common
 *
 * Build (from a Developer Command Prompt):
 *   cl /O2 /W4 /Fe:install_tree_sitter_grammar.exe install_tree_sitter_grammar.c
 */

