clear; clf;

f=@(t,y) 1-t+y;
exa=@(t) 3*exp(t)+t;

t=linspace(0,4,20);
h=t(2)-t(1);

plot(t,exa(t),'o-'); grid on; hold on

y(1)=exa(t(1));
w(1)=exa(t(1));

for i=1:length(t)-1
    y(i+1) = y(i) + h*f(t(i),y(i));
    %   w(i+1) = w(i) + h * f(t(i) + h / 2, w(i) + h / 2 * f(t(i),w(i)));
end

plot(t, y, "*-");
%plot(t, w, "dr-");
title('Sungbae Jeong')
