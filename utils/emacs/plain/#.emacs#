(setq treesit-extra-load-path
      (list (if (eq system-type 'windows-nt)
                (expand-file-name ".emacs.local/treesit" (getenv "APPDATA"))
              (expand-file-name ".emacs.local/treesit"
                                (expand-file-name "~/.config/emacs/")))))

