# NOTE: all settings came from https://www.youtube.com/watch?v=k94qImbFKWE
#
#                      ╭──────────────────────────────────╮
#                      │ Change Window Focus within Space │
#                      ╰──────────────────────────────────╯
alt - down  : yabai -m window --focus south
alt - left  : yabai -m window --focus west
alt - right : yabai -m window --focus east
alt - up    : yabai -m window --focus north

# Focus prev and next mission control
cmd - left  : yabai -m space --focus prev
cmd - right : yabai -m space --focus next

# Focus nth mission control
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7

#                            ╭───────────────────────╮
#                            │ Moving Windows Around │
#                            ╰───────────────────────╯
# swap windows
alt + shift - down  : yabai -m window --swap south
alt + shift - left  : yabai -m window --swap west
alt + shift - right : yabai -m window --swap east
alt + shift - up    : yabai -m window --swap north

# move window and split
alt + ctrl + shift - down  : yabai -m window --warp south
alt + ctrl + shift - left  : yabai -m window --warp west
alt + ctrl + shift - right : yabai -m window --warp east
alt + ctrl + shift - up    : yabai -m window --warp north
alt + shift - p : yabai -m window --space prev

# move window to prev and next space
cmd + shift - left : yabai -m window --space prev
cmd + shift - right : yabai -m window --space next

cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7

#                            ╭──────────────────────╮
#                            │ Modifying the Layout │
#                            ╰──────────────────────╯
# rotate layout clockwise
alt + shift - r : yabai -m space --rotate 270

# flip along y-axis
alt + shift - y : yabai -m space --mirror y-axis

# flip along x-axis
alt + shift - x : yabai -m space --mirror x-axis

# toggle window float
alt + shift - f : yabai -m window --toggle float --grid 4:4:1:1:2:2

#                            ╭───────────────────────╮
#                            │ Modifying Window Size │
#                            ╰───────────────────────╯
# maximize a window
alt + shift - m : yabai -m window --toggle zoom-fullscreen

# balance out tree of windows (resize to occupy same area)
alt + shift - e : yabai -m space --balance

# resize windows
ctrl + alt - down  : yabai -m window --resize bottom:0:20
ctrl + alt - left  : yabai -m window --resize left:-20:0
ctrl + alt - right : yabai -m window --resize right:20:0
ctrl + alt - up    : yabai -m window --resize top:0:-20

ctrl + alt + cmd - down  : yabai -m window --resize top:0:20
ctrl + alt + cmd - left  : yabai -m window --resize right:-20:0
ctrl + alt + cmd - right : yabai -m window --resize left:20:0
ctrl + alt + cmd - up    : yabai -m window --resize bottom:0:-20

#                      ╭──────────────────────────────────╮
#                      │ Reset yabai, skhd and sketchybar │
#                      ╰──────────────────────────────────╯
cmd + ctrl + shift - r : yabai --restart-service
alt + ctrl + shift - r : skhd --restart-service
alt + ctrl + cmd - r   : brew services restart sketchybar

#                         ╭────────────────────────────╮
#                         │ Open Applications Shortcut │
#                         ╰────────────────────────────╯
ctrl + cmd - t : kitty ~

