* {
active-background: #363D87;
active-foreground: #F9F1FB;
normal-background: #0B0C1B;
normal-foreground: #F9F1FB;
urgent-background: #6E6EB3;
urgent-foreground: #F9F1FB;

alternate-active-background: #6C699A;
alternate-active-foreground: #F9F1FB;
alternate-normal-background: #0B0C1B;
alternate-normal-foreground: #F9F1FB;
alternate-urgent-background: #0B0C1B;
alternate-urgent-foreground: #F9F1FB;

selected-active-background: #363D87;
selected-active-foreground: #F9F1FB;
selected-normal-background: #EFE3F1;
selected-normal-foreground: #F9F1FB;
selected-urgent-background: #6E6EB3;
selected-urgent-foreground: #F9F1FB;

background-color: #0B0C1B;
background: rgba(0,0,0,0.7);
foreground: #EFE3F1;
border-color: #363D87;
}
