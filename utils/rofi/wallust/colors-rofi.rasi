* {
active-background: #311E1E;
active-foreground: #FAEEE0;
normal-background: #030304;
normal-foreground: #FAEEE0;
urgent-background: #B17C67;
urgent-foreground: #FAEEE0;

alternate-active-background: #A37658;
alternate-active-foreground: #FAEEE0;
alternate-normal-background: #030304;
alternate-normal-foreground: #FAEEE0;
alternate-urgent-background: #030304;
alternate-urgent-foreground: #FAEEE0;

selected-active-background: #311E1E;
selected-active-foreground: #FAEEE0;
selected-normal-background: #F0DECB;
selected-normal-foreground: #FAEEE0;
selected-urgent-background: #B17C67;
selected-urgent-foreground: #FAEEE0;

background-color: #030304;
background: rgba(0,0,0,0.7);
foreground: #F0DECB;
border-color: #311E1E;
}
