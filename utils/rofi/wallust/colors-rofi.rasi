* {
active-background: #2B5B8F;
active-foreground: #F2FAF9;
normal-background: #000105;
normal-foreground: #F2FAF9;
urgent-background: #C5B4B3;
urgent-foreground: #F2FAF9;

alternate-active-background: #B4813F;
alternate-active-foreground: #F2FAF9;
alternate-normal-background: #000105;
alternate-normal-foreground: #F2FAF9;
alternate-urgent-background: #000105;
alternate-urgent-foreground: #F2FAF9;

selected-active-background: #2B5B8F;
selected-active-foreground: #F2FAF9;
selected-normal-background: #E4F0EE;
selected-normal-foreground: #F2FAF9;
selected-urgent-background: #C5B4B3;
selected-urgent-foreground: #F2FAF9;

background-color: #000105;
background: rgba(0,0,0,0.7);
foreground: #E4F0EE;
border-color: #2B5B8F;
}
