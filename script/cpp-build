#! /usr/local/bin/python

import sys
import os

CXX_COMPILER = "g++-11"
CXX_STD = "-std=c++20"
CXX_OPTIONS = "-O3 -Wall -Wextra -Wpedantic -Wconversion -Werror=return-type"

TARGET = "foo"

SRCS = [
    "./main.cc",
]

OBJS = ""

def run_with(list):
    return os.system(" ".join(list))

def obj_from_src(src_filename):
    pre, ext = os.path.splitext(src_filename)
    return pre + ".o"

for src_file in SRCS:
    OBJS += " " + obj_from_src(src_file)

# Main Building Part

if len(sys.argv) > 1:
    if sys.argv[1] == "build":
        for src_file in SRCS:
            run_with([CXX_COMPILER, CXX_STD, CXX_OPTIONS, src_file, "-o", obj_from_src(src_file)])
        run_with([CXX_COMPILER, OBJS, "-o", TARGET])

    elif sys.argv[1] == "clean":
        run_with(["rm", "-r", OBJS, TARGET])
else:
    print("Usage: ./cpp-build [subcommands]")
    print()
    print("SubCommands:")
    print("build    build the project")
    print("clean    clean the object and execute files")
